
name: Test iPhone Notification

on:
  workflow_dispatch:

jobs:
  notify:
    runs-on: ubuntu-latest
    steps:
      - name: Send test push
        env:
          NTFY_TOPIC: ${{ secrets.NTFY_TOPIC }}
        run: |
          if [ -z "$NTFY_TOPIC" ]; then
            echo "NTFY_TOPIC secret is missing"
            exit 1
          fi

          curl --fail-with-body \
            --retry 2 \
            -H "Title: iPhone Duo Stock Monitor" \
            -H "Priority: high" \
            -d "Test successful! Your iPhone can receive stock alerts." \
            "https://ntfy.sh/$NTFY_TOPIC"
